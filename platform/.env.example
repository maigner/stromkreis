# Lokale Entwicklung: dbmate und die Plattform lesen DATABASE_URL aus .env
# (Kopie dieser Datei als .env anlegen und anpassen)
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/stromkreis_dev?sslmode=disable"

# Anmelden mit EEGFaktura (OIDC gegen die EEG-Faktura-Keycloak) und Hintergrund-Import.
# Ohne OIDC_ISSUER/OIDC_CLIENT_ID bleibt nur der Einladungslink-Login aktiv.
PUBLIC_ORIGIN="http://localhost:5173"
OIDC_ISSUER="https://auth.eegfaktura-test.stromkreis.net/realms/EEGFaktura"
OIDC_CLIENT_ID="net.stromkreis.platform"
EEGFAKTURA_BASE_URL="https://eegfaktura-test.stromkreis.net"
# 32 Byte hex (openssl rand -hex 32): verschluesselt Refresh-Tokens in der DB, signiert Login-Cookies.
# Plattform und Pipeline-Worker brauchen denselben Wert.
TOKEN_SECRET=""
